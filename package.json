{
  "name": "vet-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm run generate && astro dev",
    "convert": "node scripts/convert.mjs",
    "watch": "node scripts/watch.mjs",
    "sync": "node scripts/sync.mjs",
    "sync:build": "pnpm run sync && pnpm run build",
    "sync:install": "node scripts/install-schedule.mjs",
    "translate:pending": "node scripts/translation.mjs",
    "format:check": "node scripts/format-check.mjs",
    "format:fix": "node scripts/format-check.mjs --fix",
    "segment:check": "node scripts/segment-check.mjs",
    "segment:fix": "node scripts/segment-check.mjs --fix",
    "review:check": "node scripts/review-check.mjs",
    "review:fix": "node scripts/review-check.mjs --fix",
    "related:check": "node scripts/related-check.mjs",
    "related:fix": "node scripts/related-check.mjs --fix",
    "ingest": "node scripts/ingest.mjs",
    "graph": "node scripts/graph.mjs",
    "generate": "pnpm run ingest && pnpm run graph",
    "build": "pnpm run generate && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check"
  },
  "dependencies": {
    "astro": "^7.4.13",
    "d3": "^7.9.2",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pagefind": "^1.6.0",
    "pdfjs-dist": "6.5.438",
    "turndown": "^7.2.5",
    "unpdf": "^2.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/d3": "^7.4.3",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.9.0"
  }
}
