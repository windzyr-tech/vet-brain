---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const categories = [...new Set(docs.map((doc) => doc.data.category || '未分类'))];
  return categories.map((category) => ({
    params: { category },
    props: { category },
  }));
}

const { category } = Astro.props;
const docs = (await getCollection('docs'))
  .filter((doc) => (doc.data.category || '未分类') === category)
  .sort((a, b) => (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0));
---

<BaseLayout title={`${category} · VetBrain`}>
  <div class="page">
    <h1>{category}</h1>
    <p class="meta-line">{docs.length} 篇文档</p>
    <div class="grid" style="margin-top: 24px;">
      {docs.map((doc) => (
        <a class="card" href={`/docs/${encodeURIComponent(doc.id)}/`}>
          <h3>{doc.data.title}</h3>
          <p>{doc.data.description || '暂无摘要'}</p>
          <div class="card-meta">{doc.data.date?.toISOString().slice(0, 10)}</div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
