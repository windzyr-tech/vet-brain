---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const docs = await getCollection('docs');
const sorted = [...docs].sort(
  (a, b) => (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0)
);

const categoryMap = new Map<string, number>();
for (const doc of docs) {
  const category = doc.data.category || '未分类';
  categoryMap.set(category, (categoryMap.get(category) || 0) + 1);
}
const categories = [...categoryMap.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout>
  <div class="page">
    <section class="hero">
      <h1>让兽医知识形成可检索、可关联的知识网络</h1>
      <p>系统整合专业文献、临床资料与学术文档，按学科体系分类整理，提供精准检索与知识图谱导航。持续更新，随时呈现最新知识脉络。</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/graph/">查看知识图谱</a>
        <a class="btn btn-ghost" href="/search/">检索知识</a>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">分类浏览</h2>
      <div class="grid">
        {categories.map(([name, count]) => (
          <a class="card" href={`/categories/${encodeURIComponent(name)}/`}>
            <h3>{name}</h3>
            <div class="card-meta">{count} 篇文档</div>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">最近收录</h2>
      <div class="grid">
        {sorted.slice(0, 6).map((doc) => (
          <a class="card" href={`/docs/${encodeURIComponent(doc.id)}/`}>
            <h3>{doc.data.title}</h3>
            <p>{doc.data.description || '暂无摘要'}</p>
            <div class="card-meta">
              <span class="badge">{doc.data.category}</span>
              {doc.data.date?.toISOString().slice(0, 10)}
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
